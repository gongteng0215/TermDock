{
  "name": "termdock",
  "version": "0.1.51",
  "description": "Cross-platform SSH + SFTP desktop client for developers and operators.",
  "packageManager": "pnpm@10.29.2",
  "main": "dist-electron/main/main.js",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/rebuild-native-for-electron.mjs",
    "rebuild:native": "node scripts/rebuild-native-for-electron.mjs",
    "dev": "concurrently -k \"pnpm run dev:renderer\" \"pnpm run dev:main\" \"pnpm run dev:electron\"",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.node.json --watch",
    "dev:electron": "wait-on http://localhost:5273 file:dist-electron/main/main.js file:dist-electron/main/preload.cjs && node scripts/run-electron-dev.mjs",
    "smoke:ui": "node scripts/smoke-capture-all.mjs",
    "smoke:ui:packaged": "pnpm run pack && node scripts/run-packaged-smoke.mjs",
    "release:self-use:cert:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-self-use-windows-cert.ps1",
    "release:self-use:win": "node scripts/build-self-use-windows-release.mjs",
    "release:prepare-secrets": "node scripts/prepare-release-secrets.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:set-secrets": "node scripts/set-release-secrets.mjs",
    "release:verify": "node scripts/verify-release-artifacts.mjs",
    "test:session-migration": "pnpm run build:main && node scripts/run-with-electron-node.mjs scripts/test-session-migration.mjs",
    "test:session-sqlite-dual-write": "pnpm run build:main && node scripts/run-with-electron-node.mjs scripts/test-session-sqlite-dual-write.mjs",
    "test:session-sqlite-cutover": "pnpm run build:main && node scripts/run-with-electron-node.mjs scripts/test-session-sqlite-cutover.mjs",
    "test:session-sqlite-crash-recovery": "pnpm run build:main && node scripts/run-with-electron-node.mjs scripts/test-session-sqlite-crash-recovery.mjs",
    "test:session-sqlite-transfer-persistence": "pnpm run build:main && node scripts/run-with-electron-node.mjs scripts/test-session-sqlite-transfer-persistence.mjs",
    "test:session-sqlite-disconnect-reports": "pnpm run build:main && node scripts/run-with-electron-node.mjs scripts/test-session-sqlite-disconnect-reports.mjs",
    "test:session-sqlite-port-forward-events": "pnpm run build:main && node scripts/run-with-electron-node.mjs scripts/test-session-sqlite-port-forward-events.mjs",
    "test:session-sqlite-workbench-data": "pnpm run build:main && node scripts/run-with-electron-node.mjs scripts/test-session-sqlite-workbench-data.mjs",
    "test:session-sqlite-app-preferences": "pnpm run build:main && node scripts/run-with-electron-node.mjs scripts/test-session-sqlite-app-preferences.mjs",
    "test:session-sqlite-app-backup": "pnpm run build:main && node scripts/run-with-electron-node.mjs scripts/test-session-sqlite-app-backup.mjs",
    "test:workspace-package": "pnpm run build:main && node scripts/run-with-electron-node.mjs scripts/test-workspace-package.mjs",
    "test:fleet-health-incidents": "pnpm run build:main && node scripts/run-with-electron-node.mjs scripts/test-fleet-health-incidents.mjs",
    "test:main-auto-update": "node scripts/test-main-auto-update.mjs",
    "test:main-single-instance": "node scripts/test-main-single-instance.mjs",
    "build": "pnpm run build:renderer && pnpm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.node.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "capture:screenshots": "node scripts/capture-product-screenshots.mjs",
    "generate:social-preview": "node scripts/generate-social-preview.mjs",
    "soak:transfer": "node scripts/soak-transfer.mjs",
    "bench:transfer:local": "node scripts/benchmark-local-transfer.mjs",
    "bench:startup": "node scripts/benchmark-startup.mjs",
    "bench:transfer:small-files": "node scripts/benchmark-transfer-small-files.mjs",
    "bench:transfer:memory": "node --expose-gc scripts/benchmark-transfer-memory.mjs",
    "pack": "pnpm run build && cross-env ELECTRON_BUILDER_BINARIES_MIRROR=https://github.com/electron-userland/electron-builder-binaries/releases/download/ electron-builder --dir --config.win.signAndEditExecutable=false",
    "dist:mac": "pnpm run build && cross-env ELECTRON_BUILDER_BINARIES_MIRROR=https://github.com/electron-userland/electron-builder-binaries/releases/download/ electron-builder --mac dmg zip --publish never",
    "dist:mac:arm64": "pnpm run build && cross-env ELECTRON_BUILDER_BINARIES_MIRROR=https://github.com/electron-userland/electron-builder-binaries/releases/download/ electron-builder --mac dmg zip --arm64 --publish never",
    "dist:mac:x64": "pnpm run build && cross-env ELECTRON_BUILDER_BINARIES_MIRROR=https://github.com/electron-userland/electron-builder-binaries/releases/download/ electron-builder --mac dmg zip --x64 --publish never",
    "dist:win": "pnpm run build && cross-env ELECTRON_BUILDER_BINARIES_MIRROR=https://github.com/electron-userland/electron-builder-binaries/releases/download/ electron-builder --win nsis zip --publish never",
    "release:mac": "pnpm run build && cross-env ELECTRON_BUILDER_BINARIES_MIRROR=https://github.com/electron-userland/electron-builder-binaries/releases/download/ electron-builder --mac dmg zip -p always",
    "release:win": "pnpm run build && cross-env ELECTRON_BUILDER_BINARIES_MIRROR=https://github.com/electron-userland/electron-builder-binaries/releases/download/ electron-builder --win nsis zip -p always"
  },
  "author": "TermDock",
  "license": "MIT",
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "electron-updater": "^6.8.3",
    "jszip": "^3.10.1",
    "keytar": "^7.9.0",
    "lucide-react": "^0.576.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@electron/rebuild": "4.0.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^26.0.12",
    "playwright": "^1.58.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.6",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.termdock.app",
    "productName": "TermDock",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "node_modules/**",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*",
      "**/node_modules/keytar/**/*"
    ],
    "mac": {
      "minimumSystemVersion": "12.0.0",
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "artifactName": "TermDock.Setup.${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "gongteng0215",
        "repo": "TermDock",
        "releaseType": "draft"
      }
    ]
  }
}
